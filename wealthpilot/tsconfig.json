{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "noFallthroughCasesInSwitch": true,
    "noEmit": true, "isolatedModules": true, "resolveJsonModule": true,
    "esModuleInterop": true, "skipLibCheck": true, "baseUrl": ".",
    "paths": {
      "@app/*": ["src/app/*"], "@pages/*": ["src/pages/*"],
      "@widgets/*": ["src/widgets/*"], "@features/*": ["src/features/*"],
      "@entities/*": ["src/entities/*"], "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
